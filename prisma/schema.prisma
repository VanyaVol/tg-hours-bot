datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Таблиця працівників
model Worker {
  id          Int       @id @default(autoincrement())
  telegramId  BigInt    @unique // ID чату в телеграмі (BigInt, бо ліміти ТГ великі)
  firstName   String
  lastName    String?
  createdAt   DateTime  @default(now())
  language   String   @default("uk") // <--- ОБОВ'ЯЗКОВО ДОДАЙ ЦЕЙ РЯДОК!
  notificationsEnabled Boolean @default(true) // Чи увімкнені сповіщення взагалі
  notificationTime  String    @default("18:00") // Час сповіщення у форматі "HH:MM"
  notificationInterval Int       @default(1) 
  currentStep String?   // <-- ДОДАЙ ЦЕ ПОЛЕ ДЛЯ ЗБЕРЕЖЕННЯ СТЕЙТУ
  calendarView        String    @default("LIST") // "LIST" або "IMAGE"
  allowCorrections     Boolean             @default(true)  // Чи дозволено коригування
  allowLeaves          Boolean             @default(true)  // Чи дозволено відпустки/лікарняні

  correctionRequests   CorrectionRequest[]

  // Зв'язок: один працівник може мати багато записів годин
  timeLogs    TimeLog[]
}

// Таблиця відпрацьованих годин
model TimeLog {
  id        Int      @id @default(autoincrement())
  date      DateTime // Дата зміни
  hours     Float    // Кількість годин (Float, бо може бути 10.5 годин)
  workerId  Int
  createdAt DateTime @default(now())

  // Посилання на таблицю Worker
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
}



model CorrectionRequest {
  id          Int           @id @default(autoincrement())
  workerId    Int
  worker      Worker        @relation(fields: [workerId], references: [id])
  date        DateTime      // Яку дату хоче змінити
  hours       Float         // Кількість годин, яку хоче поставити
  comment     String?       // Причина коригування
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}